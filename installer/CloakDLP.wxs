<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="CloakDLP"
    Manufacturer="CloakDLP"
    Version="0.6.0.0"
    UpgradeCode="17D219AF-C57B-4340-AB4D-6B3EA6B10D37"
    Language="1033"
    Scope="perMachine">

    <SummaryInformation Description="CloakDLP; content-aware DLP policy orchestrator" Manufacturer="CloakDLP" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of CloakDLP is already installed."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="CloakDLPIcon" SourceFile="cloakdlp.ico" />
    <Property Id="ARPPRODUCTICON" Value="CloakDLPIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MAXIVA11/CloakDLP" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MAXIVA11/CloakDLP" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Content-aware DLP: policy console (service) + endpoint agent (service)." />

    <!-- C:\ProgramData\CloakDLP; the runtime data directory (cloakdlp.db, jwt_secret.key,
         agent_credentials.json, logs\) that the services create themselves, not something WiX
         ever installs a File into. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CLOAKDLPDATADIR" Name="CloakDLP" />
    </StandardDirectory>

    <!-- util:RemoveFolderEx doesn't work here: its worker action (Wix4RemoveFoldersEx_X64) is
         hardcoded by the extension to sequence ~799, which runs before CostInitialize/
         CostFinalize (~1000) — the step that actually resolves what CLOAKDLPDATADIR points to.
         Confirmed directly via a verbose uninstall log: at the moment RemoveFoldersEx runs and
         fails with "Missing folder property", the very next logged action is CostInitialize
         itself, followed by "PROPERTY CHANGE: Adding CLOAKDLPDATADIR property" — the value
         plain doesn't exist yet. WiX gives no supported way to reschedule an extension's own
         action (Sequence/After attributes on the element are rejected; a second <Custom>
         referencing the same action id is rejected as a duplicate). A plain rmdir, scheduled
         explicitly After RemoveFiles (long after CostFinalize), sidesteps the whole problem.

         Directory here is the working directory CreateProcess launches cmd.exe from, not the
         thing being removed — it must NOT be INSTALLFOLDER (tried that first): by sequence
         3501, RemoveFiles has already stripped everything out of Program Files\CloakDLP\, and
         launching a process with a working directory that's mid-teardown fails outright
         (verified directly: Windows Installer error 1721, "a program required for this install
         to complete could not be run"). SystemFolder (C:\Windows\System32) always exists. -->
    <CustomAction
      Id="RemoveProgramDataFolder"
      Directory="SystemFolder"
      ExeCommand='cmd.exe /c rmdir /s /q "[CommonAppDataFolder]CloakDLP"'
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="CloakDLP">
        <Directory Id="CONSOLEDIR" Name="console">
          <Directory Id="STATICDIR" Name="static" />
        </Directory>
        <Directory Id="AGENTDIR" Name="agent" />
        <Directory Id="TRAYDIR" Name="tray" />
        <Directory Id="EXTENSIONDIR" Name="extension" />
      </Directory>
    </StandardDirectory>

    <!-- Both scheduled Execute="immediate" (the default Impersonate="yes" that goes with it runs
         the process as the actual installing user, in their session) rather than "deferred"
         (which by default runs as SYSTEM in Session 0 - fine for file operations, useless for a
         tray icon or opening a browser window, neither of which SYSTEM's session can show
         anyone). Return="asyncNoWait" because neither process ever exits on its own (the tray
         notifier runs indefinitely; the browser tab may stay open) - setup must not wait on
         them. Condition="NOT Installed" (the MSI property, true only when this ProductCode has
         never been installed before) so these fire once on a genuine first install/upgrade, not
         on every repair, and never on uninstall (Installed is set by the time REMOVE=ALL runs). -->
    <!-- Runs first, always (install, repair, uninstall, and - critically - the old side of a
         MajorUpgrade), so a still-running tray notifier from a previous install never survives
         into the new one. Discovered live: without this, upgrading over an existing install left
         TWO CloakDlp.Tray.exe processes running - the old one keeps executing from its
         already-mapped image even after RemoveFiles deletes the file out from under it (Windows
         allows that), and LaunchTrayApp below then starts a second instance for the new install,
         both connected to the incident feed and both popping duplicate notifications. Return
         "ignore" because taskkill exits non-zero when nothing matches, which must not fail
         setup. -->
    <CustomAction
      Id="StopTrayApp"
      Directory="SystemFolder"
      ExeCommand='cmd.exe /c taskkill /IM CloakDlp.Tray.exe /F'
      Execute="immediate"
      Return="ignore" />

    <CustomAction
      Id="LaunchTrayApp"
      Directory="TRAYDIR"
      ExeCommand='"[#TrayExeFile]"'
      Execute="immediate"
      Return="asyncNoWait" />

    <CustomAction
      Id="OpenConsoleInBrowser"
      Directory="SystemFolder"
      ExeCommand='cmd.exe /c start "" "http://127.0.0.1:8123/"'
      Execute="immediate"
      Return="asyncNoWait" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="CloakDLP" />
    </StandardDirectory>

    <StandardDirectory Id="StartupFolder" />

    <!-- Console: backend exe + WinSW-wrapped service registration -->
    <ComponentGroup Id="ConsoleFiles" Directory="CONSOLEDIR">
      <Component Id="ConsoleExe" Guid="*">
        <File Id="ConsoleExeFile" Source="staging\console\CloakDLP-Console.exe" KeyPath="yes" />
      </Component>
      <Component Id="ConsoleIcon" Guid="*">
        <File Id="ConsoleIconFile" Source="staging\console\cloakdlp.ico" KeyPath="yes" />
      </Component>
      <Component Id="ConsoleServiceXml" Guid="*">
        <File Id="ConsoleServiceXmlFile" Source="staging\console\CloakDLPConsoleService.xml" KeyPath="yes" />
      </Component>
      <!-- CloakDLPConsoleService.exe is WinSW (github.com/winsw/winsw), which reads the
           adjacent .xml config and behaves as a normal SCM-aware service host; WiX's
           ServiceInstall/ServiceControl below manage it exactly like the native agent service. -->
      <Component Id="ConsoleServiceExe" Guid="*">
        <File Id="ConsoleServiceExeFile" Source="staging\console\CloakDLPConsoleService.exe" KeyPath="yes" />
        <ServiceInstall
          Id="ConsoleServiceInstall"
          Name="CloakDLPConsole"
          DisplayName="CloakDLP Console"
          Description="CloakDLP policy orchestrator API and web console (http://127.0.0.1:8123)."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal" />
        <ServiceControl
          Id="ConsoleServiceControl"
          Name="CloakDLPConsole"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StaticFiles" Directory="STATICDIR">
      <Files Include="staging\console\static\**" />
    </ComponentGroup>

    <!-- Agent: self-contained exe, runs natively as a Windows Service via `agent.exe service' -->
    <ComponentGroup Id="AgentFiles" Directory="AGENTDIR">
      <Component Id="AgentConfig" Guid="*">
        <File Id="AgentConfigFile" Source="staging\agent\appsettings.json" KeyPath="yes" />
      </Component>
      <Component Id="AgentExe" Guid="*">
        <File Id="AgentExeFile" Source="staging\agent\CloakDlp.Agent.exe" KeyPath="yes" />
        <ServiceInstall
          Id="AgentServiceInstall"
          Name="CloakDLPAgent"
          DisplayName="CloakDLP Agent"
          Description="CloakDLP endpoint content-inspection agent (clipboard, print, network channels)."
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Arguments="service" />
        <ServiceControl
          Id="AgentServiceControl"
          Name="CloakDLPAgent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </ComponentGroup>

    <!-- Tray notifier: shows a notification when the agent/extension detect a card entry.
         Starts automatically at logon via a shortcut in the current user's Startup folder -
         the same standard, user-visible mechanism Dropbox/Discord/Steam etc. use; it shows up
         in Task Manager's Startup Apps tab and Settings > Apps > Startup like any other, and
         can be disabled there the same way.

         The shortcut is its own component with an HKCU keypath (not the exe file) even though
         that means it's in a different component than its Target file; Windows Installer's
         own validation (ICE43/57) requires a per-user keypath for any component containing a
         per-user-directory shortcut, which takes priority over ICE69's (non-fatal, warning
         only) preference that a shortcut share a component with its target. -->
    <ComponentGroup Id="TrayFiles" Directory="TRAYDIR">
      <Component Id="TrayConfig" Guid="*">
        <File Id="TrayConfigFile" Source="staging\tray\tray-config.json" KeyPath="yes" />
      </Component>
      <Component Id="TrayIcon" Guid="*">
        <File Id="TrayIconFile" Source="staging\tray\tray.ico" KeyPath="yes" />
      </Component>
      <Component Id="TrayExe" Guid="*">
        <File Id="TrayExeFile" Source="staging\tray\CloakDlp.Tray.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="TrayStartupShortcut" Directory="StartupFolder" Guid="4B7D8E1A-2C3F-4A9B-8E5D-1F6A9C2B7D4E">
      <Shortcut
        Id="TrayStartupShortcutFile"
        Name="CloakDLP Notifier"
        Target="[#TrayExeFile]"
        WorkingDirectory="TRAYDIR" />
      <RegistryValue
        Root="HKCU"
        Key="Software\CloakDLP"
        Name="TrayStartupInstalled"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Browser extension source, zipped for reference/store submission; not installed or
         registered with any browser. See browser-extension/README.md. -->
    <ComponentGroup Id="ExtensionFiles" Directory="EXTENSIONDIR">
      <Component Id="ExtensionZip" Guid="*">
        <File Id="ExtensionZipFile" Source="staging\CloakDLP-browser-extension.zip" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts" Directory="ShortcutFolder">
      <Component Id="OpenConsoleShortcut" Guid="18AA278C-2211-4C3D-8D98-59DFFFB3E23D">
        <File Id="OpenConsoleShortcutFile" Source="staging\CloakDLP Console.url" />
        <RemoveFolder Id="RemoveShortcutFolder" Directory="ShortcutFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\CloakDLP"
          Name="StartMenuShortcutInstalled"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Marker component; exists so RemoveProgramDataFolder (scheduled below) has something in
         the Feature tree to hang off of. No File to key off (C:\ProgramData\CloakDLP's contents
         are all runtime-generated, never installed), so the keypath is a throwaway registry
         value instead. -->
    <Component Id="CleanupProgramData" Directory="INSTALLFOLDER" Guid="6F2A9C3D-8B4E-4A1F-9D6C-2E7B5A0F3C8D">
      <RegistryValue
        Root="HKLM"
        Key="Software\CloakDLP"
        Name="Installed"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="CloakDLP" Level="1">
      <ComponentGroupRef Id="ConsoleFiles" />
      <ComponentGroupRef Id="StaticFiles" />
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentGroupRef Id="TrayFiles" />
      <ComponentRef Id="TrayStartupShortcut" />
      <ComponentGroupRef Id="ExtensionFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentRef Id="CleanupProgramData" />
    </Feature>

    <!-- REMOVE="ALL" is true for a genuine uninstall, false for a repair or a feature-level
         change — this must only ever fire when the product is actually being removed.
         Scheduled after RemoveFiles (~3500), well past CostFinalize, so
         [CommonAppDataFolder] is already resolved by the time this runs. -->
    <InstallExecuteSequence>
      <Custom Action="StopTrayApp" Before="InstallValidate" />
      <Custom Action="RemoveProgramDataFolder" After="RemoveFiles" Condition='REMOVE="ALL"' />
      <Custom Action="LaunchTrayApp" After="InstallFinalize" Condition="NOT Installed" />
      <Custom Action="OpenConsoleInBrowser" After="LaunchTrayApp" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

  </Package>
</Wix>
