{
  "manifest_version": 3,
  "name": "CloakDLP Card Entry Monitor",
  "version": "1.1.0",
  "description": "Detects a credit card number as you type it and can block submission. Only a redacted last-4 + domain go to your local console.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:8123/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
